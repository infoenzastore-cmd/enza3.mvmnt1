# Configure only with a currently verified official Testnet USDC issuer.
STELLAR_USDC_TESTNET_ISSUER=
STELLAR_MERCHANT_ADDRESS=
PORT=3000
# Hosted checkout API (leave HOST unset for the local sample demo).
# HOST=0.0.0.0
# CHECKOUT_ORIGIN=https://infoenzastore-cmd.github.io
# ORDERS_PATH=/persistent-data/enza-orders.json
# Publishable Testnet key only. Never put a Pollar secret key in the browser.
# POLLAR_PUBLISHABLE_KEY=pub_testnet_...
